
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
    previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User{
    id          String      @id   @default(uuid())
    username    String      @unique
    password    String
}
